# ╔══════════════════════════════════════════════╗
# ║   SVEN'S IMPERIUM – Konfigurationsdatei     ║
# ╚══════════════════════════════════════════════╝
#
# ANLEITUNG:
#   1. Diese Datei kopieren und umbenennen zu: .env
#   2. Deine Werte eintragen
#   3. Die .env Datei NIE auf GitHub hochladen! (ist bereits in .gitignore)
#
# Telegram Bot Token (von @BotFather auf Telegram)
TELEGRAM_TOKEN=dein_telegram_token_hier

# Deine Telegram Chat-ID (von @userinfobot auf Telegram)
TELEGRAM_CHAT_ID=deine_chat_id_hier

# ╔══════════════════════════════════════════════╗
# ║   voice2text – alles hier ist FREIWILLIG     ║
# ╚══════════════════════════════════════════════╝
#
# Ohne diese Zeilen läuft voice2text vollständig offline und kostenlos.
# Sie schalten nur Zusatzfunktionen frei.

# Sprecher-Erkennung "wer sagt was" (kostenlos, Konto auf huggingface.co)
#   Token: huggingface.co/settings/tokens
#   Vorher auf huggingface.co/pyannote/speaker-diarization-3.1
#   die Nutzungsbedingungen bestätigen.
# HUGGINGFACE_TOKEN=hf_dein_token_hier

# Zusammenfassungen mit Claude (kostet pro Anfrage)
# ANTHROPIC_API_KEY=sk-ant-dein_schluessel_hier

# Cloud-Transkription und Zusammenfassungen mit OpenAI (kostet pro Anfrage)
# OPENAI_API_KEY=sk-dein_schluessel_hier
